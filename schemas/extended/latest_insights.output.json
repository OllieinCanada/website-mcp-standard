{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcpwp:0.1:extended:latest_insights:output",
  "title": "latest_insights output",
  "description": "Insights ordered by published_at, newest first.",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "invalid_request",
        "not_found",
        "rate_limited",
        "unavailable",
        "internal_error"
      ],
      "description": "Outcome of the call. See SPECIFICATION.md section 10."
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/insight_summary"
      }
    },
    "ext": {
      "$ref": "#/$defs/ext"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "results"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "invalid_request",
              "not_found",
              "rate_limited",
              "unavailable",
              "internal_error"
            ]
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "description": "Present when status is an error status.",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "description": "Human-readable explanation."
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "For rate_limited/unavailable: when the client may retry."
        }
      }
    },
    "ext": {
      "type": "object",
      "description": "Site-specific extension fields. Clients MUST ignore members they do not understand."
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Absolute HTTPS URL."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable identifier, unique within its collection on this site."
    },
    "insight_summary": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "published_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Stable identifier (typically the slug), accepted by get_insight."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "summary": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Recommended values: article, news, research, case_study, video, podcast, other."
        },
        "published_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Topic ids from list_topics."
        },
        "series": {
          "type": "string",
          "description": "Series id from list_topics, if part of a series."
        },
        "language": {
          "$ref": "#/$defs/language"
        }
      }
    },
    "language": {
      "type": "string",
      "description": "BCP 47 language tag, e.g. 'en' or 'en-CA'.",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
    },
    "timestamp": {
      "type": "string",
      "description": "RFC 3339 date-time (e.g. 2026-11-01T09:00:00Z) or full-date (e.g. 2026-11-01).",
      "anyOf": [
        {
          "format": "date-time"
        },
        {
          "format": "date"
        }
      ]
    }
  }
}
