{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arwp:0.1:core:search_site:input",
  "title": "search_site input",
  "description": "Search across all public content of the website.",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Search terms."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 10,
      "description": "Maximum number of items to return (default 10). Servers MAY return fewer."
    },
    "cursor": {
      "$ref": "#/$defs/cursor"
    },
    "type": {
      "type": "string",
      "description": "Optional filter on result type."
    }
  },
  "required": [
    "query"
  ],
  "$defs": {
    "cursor": {
      "type": "string",
      "description": "Opaque pagination token. Absent or null when there are no more results."
    }
  }
}
