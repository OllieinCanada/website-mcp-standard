{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arwp:0.1:core:get_services:output",
  "title": "get_services output",
  "description": "Services, products or other offerings of the site or its operator, or not_applicable.",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "not_applicable",
        "invalid_request",
        "not_found",
        "unauthorized",
        "forbidden",
        "rate_limited",
        "unavailable",
        "internal_error"
      ],
      "description": "Outcome of the call. See SPECIFICATION.md section 7."
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "reason": {
      "type": "string",
      "description": "Required when status is not_applicable: why this category does not apply to the site."
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "url"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "description": "Recommended values: service, product, course, event, program, publication, resource, membership, other."
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "$ref": "#/$defs/https_url"
          },
          "category": {
            "type": "string"
          },
          "audience": {
            "type": "string"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "online",
              "in_person",
              "hybrid",
              "physical_goods",
              "digital_goods",
              "other"
            ]
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Where the offering is available (ISO 3166 codes or free text)."
          },
          "price": {
            "type": "object",
            "description": "Indicative public pricing. Omit if not published.",
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "ISO 4217 code."
              },
              "unit": {
                "type": "string",
                "description": "e.g. 'per day', 'per seat', 'one-time'."
              },
              "text": {
                "type": "string",
                "description": "Free-text price, e.g. 'From $5,000' or 'Contact for quote'."
              }
            }
          },
          "engagement_url": {
            "$ref": "#/$defs/https_url",
            "description": "Where a human can enquire about, book or buy this offering."
          },
          "updated_at": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All categories available for filtering."
    },
    "next_cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/cursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "ext": {
      "$ref": "#/$defs/ext"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "services"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "invalid_request",
              "not_found",
              "unauthorized",
              "forbidden",
              "rate_limited",
              "unavailable",
              "internal_error"
            ]
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_applicable"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ],
  "$defs": {
    "cursor": {
      "type": "string",
      "description": "Opaque pagination token. Absent or null when there are no more results."
    },
    "error": {
      "type": "object",
      "description": "Present when status is an error status.",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "description": "Human-readable explanation."
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "For rate_limited/unavailable: when the client may retry."
        }
      }
    },
    "ext": {
      "type": "object",
      "description": "Site-specific extension fields. Clients MUST ignore members they do not understand."
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Absolute HTTPS URL."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable identifier, unique within its collection on this site."
    },
    "timestamp": {
      "type": "string",
      "description": "RFC 3339 date-time (e.g. 2026-11-01T09:00:00Z) or full-date (e.g. 2026-11-01).",
      "anyOf": [
        {
          "format": "date-time"
        },
        {
          "format": "date"
        }
      ]
    }
  }
}
