{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcpwp:0.1:core:get_page:output",
  "title": "get_page output",
  "description": "A published page of this website in an agent-friendly representation.",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "not_found",
        "invalid_request",
        "rate_limited",
        "unavailable",
        "internal_error"
      ],
      "description": "Outcome of the call. See SPECIFICATION.md section 10."
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "$ref": "#/$defs/https_url",
      "description": "Canonical URL of the page."
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "content_format": {
      "$ref": "#/$defs/content_format"
    },
    "content": {
      "type": "string",
      "description": "Main content of the page with navigation, footer and other boilerplate removed."
    },
    "truncated": {
      "type": "boolean",
      "description": "true if content was shortened; the full page is at url."
    },
    "published_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "ext": {
      "$ref": "#/$defs/ext"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "title",
          "url",
          "content_format",
          "content"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "not_found",
              "invalid_request",
              "rate_limited",
              "unavailable",
              "internal_error"
            ]
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "$defs": {
    "content_format": {
      "type": "string",
      "enum": [
        "text/markdown",
        "text/plain"
      ],
      "description": "Media type of the content field."
    },
    "error": {
      "type": "object",
      "description": "Present when status is an error status.",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "description": "Human-readable explanation."
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "For rate_limited/unavailable: when the client may retry."
        }
      }
    },
    "ext": {
      "type": "object",
      "description": "Site-specific extension fields. Clients MUST ignore members they do not understand."
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Absolute HTTPS URL."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable identifier, unique within its collection on this site."
    },
    "language": {
      "type": "string",
      "description": "BCP 47 language tag, e.g. 'en' or 'en-CA'.",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
    },
    "timestamp": {
      "type": "string",
      "description": "RFC 3339 date-time (e.g. 2026-11-01T09:00:00Z) or full-date (e.g. 2026-11-01).",
      "anyOf": [
        {
          "format": "date-time"
        },
        {
          "format": "date"
        }
      ]
    }
  }
}
